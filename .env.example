# ─── Application ─────────────────────────────────────────────────────────────
# Runtime environment: development | production | test
NODE_ENV=development

# Port the NestJS API listens on
PORT=3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5433  # Use 5433 if local PostgreSQL is already on 5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=puente_radar

# Auto-sync TypeORM schema — set to true in dev, NEVER in production
DATABASE_SYNC=true  # Set to false in production; use migration:run instead

# Log all SQL queries — useful in development, disable in production
DATABASE_LOGGING=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origin for cross-origin requests (front-end URL in dev)
CORS_ORIGIN=http://localhost:3001
