# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# Local development defaults match docker-compose.yml (port 5433 to avoid conflicts)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=puente_radar

# In staging/production ALWAYS set DATABASE_SYNC=false. The EC2 deployment
# runs all pending migrations from the built image before replacing the API.
DATABASE_SYNC=true
DATABASE_LOGGING=true

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Redis is optional for local development. Railway provides this automatically
# when a Redis service is attached.
# REDIS_URL=redis://localhost:6380

# ── CORS ─────────────────────────────────────────────────────────────────────
# In production set this to your Expo / web app origin, e.g.:
# CORS_ORIGIN=https://your-app.expo.app
CORS_ORIGIN=http://localhost:8081

# ── Security ─────────────────────────────────────────────────────────────────
# Required in production. Used to protect admin endpoints (e.g. PATCH /bridges/:id/status).
# Generate a strong random value, e.g.: openssl rand -hex 32
ADMIN_API_KEY=change-me-in-production

# ── Body parser ──────────────────────────────────────────────────────────────
JSON_BODY_LIMIT=50kb

# ── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
THROTTLE_REPORTS_LIMIT=5

# ── CBP (Customs and Border Protection) wait times source ────────────────────
CBP_BASE_URL=https://bwt.cbp.gov/api/waittimes
CBP_TIMEOUT_MS=4000
CBP_TTL_MINUTES=15
