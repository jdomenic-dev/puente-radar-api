# ─── Application ─────────────────────────────────────────────────────────────
# Runtime environment: development | production | test
NODE_ENV=development

# Port the NestJS API listens on
PORT=3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5433  # Use 5433 if local PostgreSQL is already on 5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=puente_radar

# Auto-sync TypeORM schema — set to true in dev, NEVER in production
DATABASE_SYNC=true  # Set to false in production; use migration:run instead

# Log all SQL queries — useful in development, disable in production
DATABASE_LOGGING=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origin for cross-origin requests (front-end URL in dev)
CORS_ORIGIN=http://localhost:3001

# ─── Redis ────────────────────────────────────────────────────────────────────
# Optional — when not set, CBP cache falls back to PostgreSQL snapshots.
# Railway: set automatically when you add the Redis plugin.
# Local dev: redis://localhost:6379 or leave empty to skip Redis.
# REDIS_URL=redis://localhost:6379

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Global: max 60 requests per minute per IP
THROTTLE_LIMIT=60
THROTTLE_TTL_MS=60000
# POST /reports specific limit: max 5 reports per minute per IP (anti-spam)
THROTTLE_REPORTS_LIMIT=5

# ─── CBP Border Wait Times API ───────────────────────────────────────────────
CBP_BASE_URL=https://bwt.cbp.gov/api/waittimes
CBP_TIMEOUT_MS=4000
CBP_TTL_MINUTES=15
