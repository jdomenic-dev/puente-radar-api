meta {
  name: Create report (lineStatus ignored)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/reports
  body: json
  auth: none
}

body:json {
  {
    "bridgeId": "{{bridgeId}}",
    "laneType": "pedestrian",
    "lineStatus": "verified",
    "reportedWaitMinutes": 20
  }
}

docs {
  # POST /reports — lineStatus enviado por el cliente

  `lineStatus` es el estado de moderación y es **obsoleto e ignorado**: aunque el cliente
  mande `verified`, el servidor guarda `pending`. Un reportero no puede verificar su propio reporte.

  También muestra un reporte de carril peatonal (`pedestrian`).

  Cuenta para el límite de 5 requests por minuto por IP.
}

assert {
  res.status: eq 201
  res.body.lineStatus: eq pending
  res.body.laneType: eq pedestrian
}
